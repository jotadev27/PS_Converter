<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PSConverter</RootNamespace>
    <AssemblyName>PS_converter</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('assets\app.ico')">assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="tools\codec-package.json"><LogicalName>codec.catalog</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\app.ico"><LogicalName>app.icon</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\icons\*.png"><LogicalName>ui-icon.%(Filename)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\consoles\psp.png"><LogicalName>console.psp</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\consoles\ps3.png"><LogicalName>console.ps3</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\consoles\vita.png"><LogicalName>console.vita</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\consoles\ps4.png"><LogicalName>console.ps4</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
